# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (Turso Cloud SQLite or local file SQLite)
# For local testing, use file:spanju.db (will create local SQLite database)
# For production Turso deployment, use libsql://your-db.turso.io
TURSO_DATABASE_URL="file:spanju.db"
TURSO_AUTH_TOKEN=""

# Security & Session Token
JWT_SECRET="spanju_ksrg_secure_jwt_token_key_2026"

# Initial Default Credentials
ADMIN_DEFAULT_PASSWORD="admin_spanju_password"
